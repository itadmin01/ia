"<strong>Text Format:\n"
"                                        </strong>\n"
"                                        Simple text with {{argument_name}} placeholders."
msgstr ""
"<strong>Formato de texto:\r\n"
"                                        </strong>\r\n"
"                                        Texto simple con {{argument_name}} marcadores de posición."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid "<strong>Text:</strong> Plain text representation for easy reading"
msgstr ""
"<strong>Text:</strong> Representación de texto sin formato para facilitar la"
" lectura"

