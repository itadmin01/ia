#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid ""
"<i class=\"fa fa-info-circle\"/>\n"
"                                    The template is read-only here. Click the button above to edit it in the prompt record."
msgstr ""
"<i class=\"fa fa-info-circle\"/>\r\n"
"                                    La plantilla es de sólo lectura aquí. Haga clic en el botón de arriba para editarlo en el registro de solicitud."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid "<span class=\"o_stat_text\">Template</span>"
msgstr "<span class=\"o_stat_text\">Plantilla</span>"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_view_form
msgid ""
"<span class=\"o_stat_text\">Test</span>\n"
"                                <span class=\"o_stat_text\">Prompt</span>"
msgstr ""
"<span class=\"o_stat_text\">Prueba</span>\r\n"
"                                <span class=\"o_stat_text\">Pregunta</span>"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid "<span>Test Prompt: </span>"
msgstr "<span>Mensaje de prueba: </span>"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_view_form
msgid "<strong>Arguments Schema Format:</strong>"
msgstr "<strong>Formato del esquema de argumentos:</strong>"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Auto-population:</strong> Common fields are automatically added as "
"\"record_fieldname\" when you select a record"
msgstr ""
"<strong>Relleno automático:</strong> Los campos comunes se agregan "
"automáticamente como \"record_fieldname\" cuando selecciona un registro"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid ""
"<strong>Default Values:</strong> Define default values for prompt variables in JSON format.\n"
"                                    These will be used as inputs to the prompt template."
msgstr ""
"<strong>Valores predeterminados:</strong> Defina valores predeterminados para las variables de solicitud en formato JSON.\r\n"
"                                    Estos se utilizarán como entradas para la plantilla de solicitud."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid ""
"<strong>Dynamic Defaults:</strong> When enabled, you can use template syntax like\n"
"                                    <code>{{ user.name }}</code> or <code>{{ related_record.get_field('name') }}</code> in your default values."
msgstr ""
"<strong>Valores predeterminados dinámicos:</strong> Cuando está habilitado, puede usar una sintaxis de plantilla como\r\n"
"                                    <code>{{ user.name }}</code> o <code>{{ related_record.get_field('name') }}</code> en sus valores predeterminados."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid "<strong>Evaluation Error:</strong>"
msgstr "<strong>Error de evaluación:</strong>"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Generated Messages:</strong> These are the final messages that would"
" be sent to the LLM, including system messages and all processed content."
msgstr ""
"<strong>Mensajes generados:</strong> Estos son los mensajes finales que se "
"enviarían al LLM, incluidos los mensajes del sistema y todo el contenido "
"procesado."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_view_form
msgid ""
"<strong>JSON Format:\n"
"                                        </strong>\n"
"                                        Structured messages in JSON format."
msgstr ""
"<strong>Formato JSON:\r\n"
"                                        </strong>\r\n"
"                                        Mensajes estructurados en formato JSON."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid "<strong>JSON:</strong> Raw message format as used by the LLM API"
msgstr ""
"<strong>JSON:</strong> Formato de mensaje sin formato utilizado por la API "
"LLM"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Manual Evaluation:</strong> Click \"Evaluate Prompt\" to re-run "
"evaluation with modified context"
msgstr ""
"<strong>Evaluación manual:</strong> Haga clic en \"Evaluar mensaje\" para "
"volver a ejecutar la evaluación con el contexto modificado"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Pro Tip:</strong> The context includes related_model_name, "
"related_model_id, and related_res_id for debugging."
msgstr ""
"<strong>Consejo profesional:</strong> El contexto incluye "
"related_model_name, related_model_id y related_res_id para la depuración."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Related Record Access:</strong> Use {{ "
"related_record.get_field('field_name') }} in templates for direct field "
"access"
msgstr ""
"<strong>Acceso a registros relacionados:</strong> Utilice {{ "
"related_record.get_field('field_name') }} en plantillas para acceso directo "
"al campo"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Related Record:</strong> Select any record above - context will "
"auto-populate and prompt will auto-evaluate"
msgstr ""
"<strong>Registro relacionado:</strong> Seleccione cualquier registro "
"anterior: el contexto se completará automáticamente y el mensaje se evaluará"
" automáticamente"

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.llm_prompt_test_view_form
msgid ""
"<strong>Rendered Template:</strong> This shows your template after all "
"{{argument}} placeholders have been replaced with actual values."
msgstr ""
"<strong>Plantilla renderizada:</strong> Esto muestra su plantilla después de"
" que todos los marcadores de posición {{argument}} hayan sido reemplazados "
"con valores reales."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid ""
"<strong>Reset Defaults:</strong> Click \"Reset Defaults\" to automatically populate this field\n"
"                                    with default values from the selected prompt template's argument schema."
msgstr ""
"<strong>Reset Defaults:</strong> Click \"Reset Defaults\" to automatically populate this field\r\n"
"                                    con valores predeterminados del esquema de argumentos de la plantilla de solicitud seleccionada."

#. module: llm_assistant
#: model_terms:ir.ui.view,arch_db:llm_assistant.view_llm_assistant_form
msgid ""
"<strong>Template Management:</strong>\n"
"                                    The template is managed through the associated prompt record.\n"
"                                    Format:"
msgstr ""
"<strong>Gestión de plantillas:</strong>\r\n"
"                                    La plantilla se gestiona a través del registro de aviso asociado.\r\n"
"                                    Formato:"

